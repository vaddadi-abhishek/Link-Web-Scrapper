# Server Port
PORT=3000

# Google Gemini API Key (Free Tier available at https://aistudio.google.com)
# Obtain your free API key from Google AI Studio and paste it below:
GEMINI_API_KEY=your_free_gemini_api_key_here

# Enable Multimodal AI Visual Intelligence during extraction (true/false)
ENABLE_AI_VISUAL=true

# Per-model generation timeout in milliseconds before falling over to next model (default: 7000)
AI_MODEL_TIMEOUT_MS=7000
